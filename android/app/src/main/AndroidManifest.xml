<?xml version="1.0" encoding="utf-8"?>
<!-- Hush Hall TWA: one launcher activity that opens the live site full screen.
     No extra permissions: the microphone for study-room voice is asked for by
     the browser engine (Chrome), the same way as on the website. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the internet: the app is the website -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app find the browsers that can show a Trusted Web Activity (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <!-- App-side Digital Asset Links statement (the site side is /.well-known/assetlinks.json) -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <!-- The launcher: opens defaultUrl in a Trusted Web Activity -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="${defaultUrl}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:value="${navColor}" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE" android:resource="@drawable/splash" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR" android:value="${backgroundColor}" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION" android:value="300" />
            <meta-data android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY" android:value="app.hushhall.android.fileprovider" />
            <meta-data android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION" android:value="any" />

            <!-- Shown in the launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the site (e.g. the magic sign-in link) open in the app once verified -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${hostName}" />
            </intent-filter>
        </activity>

        <!-- Shares the splash image with the browser while the site loads -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.hushhall.android.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
