# Hush Hall environment. Copy to .env.local (never commit .env.local).
# Without the Supabase values the app runs in offline demo mode.

# Supabase project (Project Settings -> API). The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret (Project Settings -> API -> service_role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit (voice in study rooms). Leave empty to run rooms without voice.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
